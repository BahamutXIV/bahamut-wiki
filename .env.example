# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Bot password: created at Special:BotPasswords, named bahamut-sync. WIKI_USER
# is your wiki username followed by @bahamut-sync.
# The subdomain is bahamut.miraheze.org.

WIKI_USER=YourUsername@bahamut-sync
WIKI_BOT_PASS=replace-with-bot-password
WIKI_API_URL=https://bahamut.miraheze.org/w/api.php
